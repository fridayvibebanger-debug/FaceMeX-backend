# Production environment sample (NO real secrets)
# Copy this file and set real values in your hosting dashboard (Render / Netlify / Vercel)

# MongoDB (MongoDB Atlas connection string)
MONGODB_URI=your_mongodb_connection_string_here

# JWT secret for auth tokens
JWT_SECRET=your_jwt_secret_here

# CORS: frontend origin(s) (comma separated)
CLIENT_ORIGIN=https://your-frontend.example

# Cloudinary (server uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# DeepSeek / OpenAI keys (optional)
DEEPSEEK_API_KEY=your_deepseek_api_key
OPENAI_API_KEY=your_openai_api_key

# Local AI toggle (set true only if you provide local GPT model files on the server)
USE_LOCAL_AI=false

# YOCO: either provide secret key to create checkouts server-side
YOCO_SECRET_KEY=your_yoco_secret
YOCO_SECRET_KEY=your_yoco_secret_key_here
YOCO_MODE=test

# Fallback hosted payment links (optional)
YOCO_PAYMENT_URL_PRO=https://pay.example.com/pro
YOCO_PAYMENT_URL_CREATOR=https://pay.example.com/creator

# Server port
PORT=4000

# Supabase (if used by backend)
VITE_SUPABASE_URL=https://your-supabase-url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
