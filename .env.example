PORT=4000
CLIENT_ORIGIN=https://facemexsocial.com,https://facemexsocial.netlify.app
JWT_SECRET=replace_with_jwt_signing_secret

# Configure these as private Render environment variables. Never add real values here.
UNSPLASH_ACCESS_KEY=replace_with_render_secret
YOUTUBE_API_KEY=replace_with_render_secret

# Database and identity providers
MONGODB_URI=replace_with_mongodb_connection_string
FIREBASE_PROJECT_ID=replace_with_firebase_project_id
FIREBASE_CLIENT_EMAIL=replace_with_firebase_client_email
FIREBASE_PRIVATE_KEY=replace_with_firebase_private_key
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=replace_with_cloudinary_upload_preset
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret

# Billing
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
YOCO_SECRET_KEY=replace_with_yoco_secret_key

# AI providers
USE_LOCAL_AI=false
DEEPSEEK_API_KEY=replace_with_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat
OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4o-mini
HF_API_KEY=replace_with_huggingface_api_key
HF_IMAGE_CAPTION_MODEL=Salesforce/blip-image-captioning-large
LLAMA_API_KEY=replace_with_llama_api_key
LLAMA_API_BASE_URL=replace_with_llama_api_base_url
LLAMA_MODEL=llama-3.1-8b-instruct
GPT4ALL_MODEL_DIR=replace_with_local_gpt4all_model_directory
LOCAL_GPT4ALL_MODEL_UTILITY=replace_with_utility_model_filename
LOCAL_GPT4ALL_MODEL_CHAT=replace_with_chat_model_filename
LOCAL_GPT4ALL_MODEL_TOOLS=replace_with_tools_model_filename

# Supabase
SUPABASE_URL=replace_with_supabase_url
SUPABASE_ANON_KEY=replace_with_supabase_anon_key
VITE_SUPABASE_URL=replace_with_supabase_url
VITE_SUPABASE_ANON_KEY=replace_with_supabase_anon_key
VITE_SUPABASE_STORAGE_BUCKET=media

# Voice providers (set as private Render environment variables)
DEEPGRAM_API_KEY=replace_with_deepgram_api_key
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US
AWS_ACCESS_KEY_ID=replace_with_aws_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_access_key
AWS_REGION=us-east-1
AWS_POLLY_VOICE_ID=Joanna
AWS_POLLY_ENGINE=neural
ELEVENLABS_API_KEY=replace_with_elevenlabs_api_key
ELEVENLABS_VOICE_ID=replace_with_elevenlabs_voice_id
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Optional: elevenlabs or polly. Defaults to the other configured provider.
VOICE_TTS_FALLBACK_PROVIDER=

# Gmail Email Assistant (configure as private Render environment variables)
GOOGLE_CLIENT_ID=replace_with_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://your-render-service.onrender.com/api/email/google/callback
GMAIL_TOKEN_ENCRYPTION_KEY=replace_with_base64_32_byte_key
